# MySQL (en Hostinger: hPanel → Bases de datos → MySQL. Copia ahí host, base, usuario y contraseña.)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_agenciaeh
DB_USER=u000000000_eh
DB_PASSWORD=CAMBIA_ESTA_PASSWORD
DB_POOL_MAX=5

JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters-access"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-refresh-secret"
PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# Correos que serán administradores (separados por comas). Cada persona se
# registra normalmente en el sitio y al registrarse/iniciar sesión pasa a ADMIN.
ADMIN_EMAILS=

# Carpeta para las fotos subidas. Por defecto ~/agencia-eh-uploads (fuera de la
# carpeta de la app, para que no se borren al subir un ZIP nuevo).
# UPLOADS_DIR=

# Correo (recuperar contraseña y verificar cuenta). En Hostinger crea una cuenta
# en hPanel → Correos (p. ej. no-reply@tudominio.com) y usa:
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# MAIL_FROM="Agencia EH <no-reply@tudominio.com>"
