# SQL Server: la base AgenciaEH debe existir antes de iniciar la API.
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=AgenciaEH
SQLSERVER_USER=eh_user
SQLSERVER_PASSWORD=CAMBIA_ESTA_PASSWORD
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
SQLSERVER_POOL_MAX=10

JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters-access"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-refresh-secret"
PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
