# URL de la API NestJS, usada por el servidor de Next.js (proxy /api/v1 y
# páginas renderizadas en el servidor). Se lee en tiempo de ejecución, así que
# puedes cambiarla sin volver a compilar.
#   Desarrollo:            http://localhost:4000/api/v1
#   Hostinger (ejemplo):   https://api.tudominio.com/api/v1
API_URL=http://localhost:4000/api/v1
